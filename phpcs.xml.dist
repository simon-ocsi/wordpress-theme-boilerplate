<?xml version="1.0"?>
<ruleset name="WordPress Theme Boilerplate">
    <description>WordPress Coding Standards for the starter theme.</description>

    <file>wp-content/themes/encoding-test</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/acf-json/*</exclude-pattern>

    <arg name="extensions" value="php" />
    <arg value="sp" />

    <rule ref="WordPress" />
    <rule ref="WordPress-Extra" />
    <rule ref="WordPress-Docs" />

    <config name="minimum_supported_wp_version" value="7.1" />
    <config name="testVersion" value="8.3-" />
</ruleset>
