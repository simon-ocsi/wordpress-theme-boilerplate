{
  "name": "starter-theme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{js,scss,css,json}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,scss,css,json}\" \"*.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vite-plugin-full-reload": "^1.2.0"
  },
  "dependencies": {
    "lucide": "^1.40.0"
  }
}
